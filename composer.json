{
    "name": "tanzeem/hrms",
    "description": "Tanzeem",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "twig/twig": "^3.0",
        "nikic/fast-route": "^1.3",
        "robmorgan/phinx": "^0.15",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Core\\": "core/",
            "App\\Apps\\": "apps/",
            "App\\Utilities\\": "utilities/"
        },
        "files": [
            "utilities/external_apis/pwnedpasswords.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.99"
        }
    }
}
