{#
    Client-side checks here deliberately mirror ValidationManager's rules
    but stay looser than the server's exact regex where an exact mirror
    would risk false negatives — the server in utilities/ValidationManager.php
    remains the authoritative check either way. minPasswordLength is opt-in
    per call site (not inferred from type="password") because it's a
    signup/password-creation rule, not a login rule — login's password
    field must never reject a real, already-set password that happens to
    be shorter than the signup minimum. checkEmailAvailable is the same
    kind of opt-in, for the same reason — login's email field must never
    trigger an "already registered" check.
#}
{% macro field(name, label, type, value, error, minPasswordLength, checkEmailAvailable) %}
    <div class="field">
        <label for="field_{{ name }}">{{ label }}</label>
        <div class="input-wrap">
            <input
                type="{{ type }}"
                id="field_{{ name }}"
                name="{{ name }}"
                value="{{ value }}"
                required
                {%- if type == 'password' and minPasswordLength %} minlength="{{ minPasswordLength }}" data-check-pwned{% endif %}
                {%- if type == 'email' and checkEmailAvailable %} data-check-email{% endif %}
                {%- if type == 'tel' %} placeholder="03001234567" pattern="[0-9+\-\s]{10,15}" title="Enter a Pakistani mobile number, e.g. 03001234567"{% endif %}
                {%- if name == 'cnic' %} placeholder="12345-1234567-1" pattern="[0-9\-]{13,15}" title="Enter a valid 13-digit CNIC, e.g. 12345-1234567-1" data-check-cnic{% endif %}
                {%- if name == 'ntn' %} placeholder="1234567-8" pattern="[A-Za-z0-9\-]{7,9}" title="Enter a valid NTN, e.g. 1234567-8"{% endif %}
                {%- if name == 'otp' %} placeholder="123456" inputmode="numeric" pattern="\d{6}" maxlength="6" autocomplete="one-time-code" title="Enter the 6-digit verification code"{% endif %}
            >
            {%- if type == 'password' %}
                <button type="button" class="password-toggle" data-password-toggle aria-label="Show password">
                    <span class="password-toggle-icons">
                        <svg class="icon-eye is-active" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="icon-eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a20.3 20.3 0 0 1 5.06-6.06M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a20.3 20.3 0 0 1-3.22 4.44M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </span>
                </button>
            {%- endif %}
        </div>
        <div class="error">{{ error }}</div>
    </div>
{% endmacro %}
