{% extends "base.twig" %}

{% block content %}
    {% set active_nav = 'employees' %}
    {% set page_title = 'Employees' %}

    {% embed "components/layout.twig" %}
        {% block dashboard_content %}
            <table class="ledger">
                <thead>
                    <tr><th>Name</th><th>Email</th></tr>
                </thead>
                <tbody>
                    {% for employee in employees %}
                        <tr>
                            <td><a href="/employees/{{ employee.id }}">{{ employee.first_name }} {{ employee.last_name }}</a></td>
                            <td>{{ employee.email }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="2">No employees yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
