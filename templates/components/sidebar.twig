<aside class="sidebar" id="sidebar">
    <div class="sidebar-top">
        <div class="brand"><span class="brand-text">Tanzeem</span></div>
        <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
            <svg class="icon icon-collapse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="9" y1="4" x2="9" y2="20"/><path d="M14 9l-2 3 2 3"/></svg>
            <svg class="icon icon-expand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="9" y1="4" x2="9" y2="20"/><path d="M12 9l2 3-2 3"/></svg>
        </button>
    </div>
    <nav>
        <a href="/dashboard"{% if active_nav == 'dashboard' %} class="active"{% endif %}><span class="nav-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7"/><path d="M9 22V12h6v10"/><path d="M21 22H3"/></svg></span><span class="label">Dashboard</span></a>
        <a href="/employees"{% if active_nav == 'employees' %} class="active"{% endif %}><span class="nav-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><span class="label">Employees</span></a>
        <a href="#"><span class="nav-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M9 16l2 2 4-4"/></svg></span><span class="label">Attendance</span></a>
        <a href="#"><span class="nav-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg></span><span class="label">Leave</span></a>
        <a href="#"><span class="nav-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span><span class="label">Payroll</span></a>
    </nav>
</aside>

<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<script>
(function () {
    var sidebar = document.getElementById('sidebar');
    var toggle = document.getElementById('sidebarToggle');
    var STORAGE_KEY = 'tanzeem-sidebar-collapsed';

    try {
        if (localStorage.getItem(STORAGE_KEY) === '1') {
            sidebar.classList.add('collapsed');
        }
    } catch (e) {}

    toggle.addEventListener('click', function () {
        sidebar.classList.toggle('collapsed');
        try {
            localStorage.setItem(STORAGE_KEY, sidebar.classList.contains('collapsed') ? '1' : '0');
        } catch (e) {}
    });

    // Below 860px the sidebar becomes an off-canvas drawer instead of an
    // inline column (see the matching @media block in design-system.css)
    // — opened via the hamburger button in header.twig, which is why
    // this part waits for DOMContentLoaded: header.twig renders after
    // this script tag in the page source.
    document.addEventListener('DOMContentLoaded', function () {
        var navToggle = document.getElementById('mobileNavToggle');
        var backdrop = document.getElementById('sidebarBackdrop');
        if (!navToggle || !backdrop) {
            return;
        }

        function closeDrawer() {
            sidebar.classList.remove('mobile-open');
            backdrop.classList.remove('visible');
        }

        navToggle.addEventListener('click', function () {
            sidebar.classList.toggle('mobile-open');
            backdrop.classList.toggle('visible');
        });

        backdrop.addEventListener('click', closeDrawer);
        sidebar.querySelectorAll('nav a').forEach(function (link) {
            link.addEventListener('click', closeDrawer);
        });
    });
})();
</script>
