{% extends "base.twig" %}

{% block content %}
    {% set active_nav = 'dashboard' %}
    {% set page_title = 'Dashboard' %}

    {% embed "components/layout.twig" %}
        {% block dashboard_content %}
            <h2 class="dashboard-welcome" data-user-name="{{ user_name }}">{{ greeting }}{% if user_name %}, {{ user_name }}{% endif %}</h2>
            <script>
                // The server-rendered greeting above is a best-effort fallback
                // (server clock, not the visitor's) — this corrects it to the
                // visitor's own local time the moment the page loads.
                document.addEventListener('DOMContentLoaded', function () {
                    var el = document.querySelector('.dashboard-welcome');
                    if (!el) {
                        return;
                    }

                    var hour = new Date().getHours();
                    var greeting = hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening';
                    var name = el.dataset.userName;

                    el.textContent = name ? greeting + ', ' + name : greeting;
                });
            </script>

            <div class="cards">
                {% embed "components/card.twig" with {title: 'You', free_layout: true} %}
                    {% block content %}
                        {% import "components/you-card.twig" as you_card %}
                        {{ you_card.card(you) }}
                    {% endblock %}
                {% endembed %}

                {% embed "components/card.twig" with {title: 'Employees'} %}
                    {% block content %}
                        {% import "components/stat-card.twig" as stat %}
                        {{ stat.card('Total', employee_count) }}
                        {{ stat.card("This month's hires", employee_hires_this_month, null, false, employee_hires_this_month > 0 ? 'status-success' : null) }}
                        {{ stat.card("This month's promotions", '—') }}
                        {{ stat.card("This month's resignations", '—') }}
                    {% endblock %}
                {% endembed %}

                {% if is_admin %}
                    {% embed "components/card.twig" with {title: 'Workforce'} %}
                        {% block content %}
                            {% import "components/stat-card.twig" as stat %}
                            {{ stat.card('Employees', employee_count, employee_limit ? '/ ' ~ employee_limit : null) }}
                            {{ stat.card('On leave', '—') }}
                            {{ stat.card("This month's payroll", '—') }}
                        {% endblock %}
                    {% endembed %}

                    {% embed "components/card.twig" with {title: 'Subscription'} %}
                        {% block content %}
                            {% import "components/stat-card.twig" as stat %}
                            {{ stat.card('Plan', plan_name ? (is_trial ? plan_name : plan_name ~ (plan_billing_cycle ? '-' ~ plan_billing_cycle|capitalize : '')) : '—', null, true) }}
                            {{ stat.card('Subscription Status', subscription_status ? subscription_status|capitalize : '—', null, false, subscription_status_variant ? 'status-' ~ subscription_status_variant : null) }}
                            {{ stat.card(is_trial ? 'Trial Valid Until' : 'Next Renewal Date', next_renewal_date ? next_renewal_date|date('M j, Y') : '—') }}
                            {{ stat.card('Renewal Amount', plan_price is not null ? 'PKR ' ~ plan_price|number_format(0) : '—') }}
                        {% endblock %}
                    {% endembed %}
                {% endif %}
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
